# Клиентские переменные — попадают в браузер, это публичный ключ.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Серверные переменные — только для локальных скриптов (npm run seed / verify).
# В репозиторий и в фронтенд не попадают никогда.
SUPABASE_SERVICE_ROLE_KEY=

# Пароли тестовых аккаунтов для скрипта создания пользователей.
TEST_MANAGER_EMAIL=manager@crm.test
TEST_MANAGER_PASSWORD=Manager123!
TEST_EXECUTOR1_EMAIL=executor1@crm.test
TEST_EXECUTOR1_PASSWORD=Executor123!
TEST_EXECUTOR2_EMAIL=executor2@crm.test
TEST_EXECUTOR2_PASSWORD=Executor123!
